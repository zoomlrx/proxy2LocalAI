# Bridge 访问 token。请在真实使用时改成足够长的随机字符串。
PROXY2LOCALAI_TOKEN=change-me-to-a-random-local-token

# Bridge 监听端口。
PROXY2LOCALAI_PORT=39399

# 可选：指定配置和日志目录。
# PROXY2LOCALAI_DATA_DIR=C:/Users/me/AppData/Roaming/Proxy2LocalAI

# 可选：允许 Claude/Codex 使用跳过权限确认的危险自动化参数。
# 仅在你理解本机项目目录和 CLI 权限风险后开启。
# PROXY2LOCALAI_ALLOW_DANGEROUS_CLI=false
