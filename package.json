{
  "name": "proxy2localai",
  "version": "0.1.0",
  "description": "Chrome/Edge MV3 extension and local bridge for proxying selected API requests to local Claude Code, Codex, or custom AI CLIs.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoomlrx/web2LocalAgent.git"
  },
  "bugs": {
    "url": "https://github.com/zoomlrx/web2LocalAgent/issues"
  },
  "homepage": "https://github.com/zoomlrx/web2LocalAgent#readme",
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "edge-extension",
    "local-ai",
    "claude-code",
    "codex",
    "proxy"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/bridge",
    "apps/extension"
  ],
  "scripts": {
    "build": "npm run build -w @proxy2localai/shared && npm run build -w @proxy2localai/bridge && npm run build -w @proxy2localai/extension",
    "dev:bridge": "npm run dev -w @proxy2localai/bridge",
    "dev:extension": "npm run dev -w @proxy2localai/extension",
    "start:bridge": "node apps/bridge/dist/index.js",
    "doctor": "node scripts/doctor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck -w @proxy2localai/shared && npm run typecheck -w @proxy2localai/bridge && npm run typecheck -w @proxy2localai/extension",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
